{
  "manifest_version": 3,
  "name": "集好運 · Community Lottery Winners",
  "version": "1.0.0",
  "description": "在本機擷取 Instagram 留言與回覆，檢視資格、抽獎並匯出結果。",
  "minimum_chrome_version": "120",
  "permissions": ["scripting"],
  "host_permissions": ["https://www.instagram.com/*"],
  "action": { "default_title": "開啟集好運抽獎工作室" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self'; img-src 'self' data:;"
  }
}
